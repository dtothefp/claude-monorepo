# Child projects are independent repos, cloned in and tracked on their own remotes
packages/*/
!packages/.gitkeep

# Secrets, never commit
.env
.env.*
!.env.example
.credentials/
*.pem
*.key

# Local agent settings (machine-specific permissions, etc.)
.claude/settings.local.json

# Scratch
context/
*.log
.DS_Store

# Knowledge-graph build output (regenerates from research/)
graphify-out/

# Semantic search index (see docs/semantic-search-plan.md). A build artifact,
# and one that would carry package-wiki content into this public repo.
*.wiki-index.db
*.wiki-index.db-wal
*.wiki-index.db-shm

# Private raw captures. The parent wiki is public, so a source that enumerates
# private projects stays on disk and out of the repo while its synthesis ships.
# The synthesis names it in sources_note so the gap is stated, not hidden.
research/retrieval/ref/graphify-sqlite-embeddings-handoff-2026-08-11.md

# Node / build
node_modules/
dist/
build/
.next/
out/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Transcription + model cache (large, regenerates)
.cache/

# Terraform. State carries project numbers and IAM bindings, tfvars carries org
# IDs and admin emails. Only the .example files are committed.
**/.terraform/
**/.terraform.lock.hcl
**/terraform.tfstate
**/terraform.tfstate.*
**/tfplan
**/*.tfplan
**/terraform.tfvars
**/*.auto.tfvars

# cowork-doctor: required entries
/app
.gws-accounts.json
.linear-accounts.json
.slack-accounts.json
.bin/
